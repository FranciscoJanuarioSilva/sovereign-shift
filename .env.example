# copy to .env and fill in. .env is gitignored.
# ai: openrouter global host, pinned to mistral in code (eu.openrouter.ai needs a business plan)
SOVEREIGN_AI_BASE_URL=https://openrouter.ai/api/v1
SOVEREIGN_AI_API_KEY=
SOVEREIGN_AI_MODEL=mistralai/mistral-small-2603
# aws: read-only profile in ~/.aws, never keys here
AWS_PROFILE=sovereign-readonly
AWS_REGION=eu-north-1
# leaseweb public cloud api token
LEASEWEB_TOKEN=
